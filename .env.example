NODE_ENV=development
# postgres uses the hosted Neon database; mssql retains local SQL Server.
DB_PROVIDER=postgres
DATABASE_URL=
PORT=4000
HOST=0.0.0.0
APP_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:4000
# SQL Server / SSMS: Windows Authentication uses the current Windows account.
SQLSERVER_AUTH=windows
SQLSERVER_SERVER=localhost
SQLSERVER_DATABASE=bella_crosta
SQLSERVER_ODBC_DRIVER=ODBC Driver 18 for SQL Server
SQLSERVER_ENCRYPT=true
# Development only, for the local SQL Server's self-signed certificate.
SQLSERVER_TRUST_CERTIFICATE=true
# For an existing SQL login or remote production deployment, use auth=sql.
# SQLSERVER_AUTH=sql
# SQLSERVER_PORT=1433
# SQLSERVER_USER=
# SQLSERVER_PASSWORD=
# SQLSERVER_TRUST_CERTIFICATE=false
# npm run dev supplies a persistent development JWT_SECRET when empty.
JWT_SECRET=
DELIVERY_FEE_EGP=35
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
# Browser Maps key: restrict by website referrer and to Maps JavaScript API.
GOOGLE_MAPS_API_KEY=
# JavaScript map ID from Google Maps > Map Management; optional in development.
GOOGLE_MAPS_MAP_ID=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
ONESIGNAL_SITE_URL=http://localhost:4000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
